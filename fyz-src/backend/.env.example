# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jie_bang
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/jie_bang

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Optional initial administrator bootstrap
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# DeepSeek / Agent
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_MAX_ATTEMPTS=2
# L4/L5 的上下文与结构化输出更长，使用独立超时并限制并发，避免同时压垮上游连接。
GRAPH_ENRICHMENT_TIMEOUT_SECONDS=120
GRAPH_ENRICHMENT_MAX_ATTEMPTS=2
GRAPH_ENRICHMENT_CONCURRENCY=2

# OpenAI-compatible Embedding / RAG
# Keep the real key only in .env or the deployment secret manager.
RETRIEVAL_EMBEDDING_PROVIDER=openai
RETRIEVAL_VECTOR_BACKEND=chroma
RETRIEVAL_RELATIVE_SCORE_WINDOW=0.04
RETRIEVAL_SEMANTIC_SCORE_FLOOR=0.30
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072
OPENAI_EMBEDDING_BATCH_SIZE=64
OPENAI_EMBEDDING_TIMEOUT_SECONDS=60

# Chroma uses an embedded persistent client for Phase 2 local deployment.
CHROMA_MODE=persistent
CHROMA_PERSIST_PATH=./storage/chroma

# Redis / Celery
#CELERY_BROKER_URL=redis://localhost:6379/0
#CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Data import root
DATA_DIR=../../data

# Private resume storage; never expose this directory as static files.
LOCAL_STORAGE_PATH=./storage
