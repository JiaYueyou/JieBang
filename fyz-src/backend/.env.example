# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jie_bang
# DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/jie_bang

# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# Optional initial administrator bootstrap
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# DeepSeek / Agent
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10

# Redis / Celery
#CELERY_BROKER_URL=redis://localhost:6379/0
#CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=true

# Data import root
DATA_DIR=../../data

# Private resume storage; never expose this directory as static files.
LOCAL_STORAGE_PATH=./storage
