# Local ports. Only HTTP_PORT is published by the base deployment file.
HTTP_PORT=18080
API_FORWARD_PORT=18000
MYSQL_FORWARD_PORT=23306
NEO4J_HTTP_FORWARD_PORT=17474
NEO4J_BOLT_FORWARD_PORT=17687
REDIS_FORWARD_PORT=16379
REDIS_CACHE_FORWARD_PORT=16380

# Use URL-safe values for passwords embedded in Redis URLs.
MYSQL_ROOT_PASSWORD=change_mysql_root_password
MYSQL_DATABASE=jie_bang
MYSQL_USER=jiebang
MYSQL_PASSWORD=change_mysql_app_password
NEO4J_PASSWORD=change_neo4j_password
REDIS_PASSWORD=change_redis_password
REDIS_CACHE_PASSWORD=change_redis_cache_password
JWT_SECRET_KEY=change_to_a_long_random_jwt_secret

# Redis cache is optional at runtime; failures fall back to MySQL/Neo4j.
CACHE_ENABLED=true
CACHE_KEY_PREFIX=jiebang:fyz:v1
CACHE_DEFAULT_TTL_SECONDS=120
CACHE_TASK_ACTIVE_TTL_SECONDS=15
CACHE_TASK_TERMINAL_TTL_SECONDS=86400
CACHE_CONNECT_TIMEOUT_SECONDS=0.5
CACHE_SOCKET_TIMEOUT_SECONDS=1.0
CACHE_WARM_INTERVAL_SECONDS=60

# First local startup only. Disable after the account has been created.
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change_initial_admin_password
JWT_EXPIRE_MINUTES=120

# External model providers are optional for infrastructure testing.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_MAX_ATTEMPTS=2

# Safe local defaults do not call an external embedding API.
RETRIEVAL_EMBEDDING_PROVIDER=local_hash
RETRIEVAL_VECTOR_BACKEND=local_hash
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=3072

# The path is resolved relative to deploy/compose.yml.
FYZ_DATA_HOST_PATH=../data

# Keep disabled in the first Docker verification. The current scheduler runs
# inside the single FYZ API process and can be enabled after crawler validation.
AUTO_PIPELINE_ENABLED=false
AUTO_PIPELINE_INTERVAL_MINUTES=1440
AUTO_PIPELINE_STARTUP_DELAY_SECONDS=60
AUTO_PIPELINE_SOURCE_IDS=4,5,6
